    {
      "name": "empty lists keep the band-wide convention for one profile",
      "package": {
        "band": { "id": "contract" },
        "profiles": [],
        "equipment_lists": [],
        "special_rules": [
          { "id": "band--contract-empty-both", "applies_to": { "band": true, "profile_ids": [] }, "eligibility": [], "runtime": { "grant": "band", "implemented": "NO" } },
          { "id": "band--contract-empty-recipients", "applies_to": { "band": true, "profile_ids": [] }, "eligibility": ["wizard"], "runtime": { "grant": "band", "implemented": "NO" } },
          { "id": "band--contract-empty-eligibility", "applies_to": { "band": true, "profile_ids": ["dwarf"] }, "eligibility": [], "runtime": { "grant": "band", "implemented": "NO" } },
          { "id": "band--contract-absent", "applies_to": { "band": true }, "runtime": { "grant": "band", "implemented": "NO" } }
        ]
      },
      "profile": { "id": "wizard" },
      "expected_rule_ids": ["band--contract-empty-both", "band--contract-empty-recipients", "band--contract-absent"]
    },
    {
      "name": "empty lists keep the band-wide convention for its named profile",
      "package": {
        "band": { "id": "contract" },
        "profiles": [],
        "equipment_lists": [],
        "special_rules": [
          { "id": "band--contract-empty-both", "applies_to": { "band": true, "profile_ids": [] }, "eligibility": [], "runtime": { "grant": "band", "implemented": "NO" } },
          { "id": "band--contract-empty-recipients", "applies_to": { "band": true, "profile_ids": [] }, "eligibility": ["wizard"], "runtime": { "grant": "band", "implemented": "NO" } },
          { "id": "band--contract-empty-eligibility", "applies_to": { "band": true, "profile_ids": ["dwarf"] }, "eligibility": [], "runtime": { "grant": "band", "implemented": "NO" } },
          { "id": "band--contract-absent", "applies_to": { "band": true }, "runtime": { "grant": "band", "implemented": "NO" } }
        ]
      },
      "profile": { "id": "dwarf" },
      "expected_rule_ids": ["band--contract-empty-both", "band--contract-empty-eligibility", "band--contract-absent"]
    },
    {
      "name": "profile-branch rules are listed first and never duplicated",
      "package": {
        "band": { "id": "contract" },
        "profiles": [],
        "equipment_lists": [],
        "special_rules": [
          { "id": "band--contract-wide", "applies_to": { "band": true }, "runtime": { "grant": "band", "implemented": "NO" } },
          { "id": "band--dwarf-special-skills", "applies_to": { "band": true, "profile_ids": ["dwarf"] }, "runtime": { "grant": "band", "implemented": "YES" } }
        ]
      },
      "profile": { "id": "dwarf", "rule_ids": ["band--dwarf-special-skills"] },
      "expected_rule_ids": ["band--dwarf-special-skills", "band--contract-wide"]
    },
    {
      "name": "explicit rule ids keep applying outside the recipient filter",
      "package": {
        "band": { "id": "contract" },
        "profiles": [],
        "equipment_lists": [],
        "special_rules": [
          { "id": "dwarf--hard-to-kill", "applies_to": { "profile_ids": ["dwarf"] }, "runtime": { "grant": "profile", "implemented": "YES" } },
          { "id": "profile--contract-explicit", "applies_to": { "profile_ids": ["elf"] }, "runtime": { "grant": "profile", "implemented": "NO" } },
          { "id": "band--contract-wide", "applies_to": { "band": true }, "runtime": { "grant": "band", "implemented": "NO" } }
