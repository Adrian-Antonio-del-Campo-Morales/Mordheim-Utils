        "equipment_lists": [],
        "special_rules": [
          { "id": "band--contract-conjunction", "applies_to": { "band": true, "profile_ids": ["dwarf", "elf"] }, "eligibility": ["dwarf"], "runtime": { "grant": "band", "implemented": "NO" } },
          { "id": "band--contract-wide", "applies_to": { "band": true }, "runtime": { "grant": "band", "implemented": "NO" } }
