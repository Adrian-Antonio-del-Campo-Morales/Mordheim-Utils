        "equipment_lists": [],
        "special_rules": [
          { "id": "band--contract-disjoint", "applies_to": { "band": true, "profile_ids": ["dwarf"] }, "eligibility": ["elf"], "runtime": { "grant": "band", "implemented": "NO" } },
          { "id": "band--contract-wide", "applies_to": { "band": true }, "runtime": { "grant": "band", "implemented": "NO" } }
        ]
      },
      "profile": { "id": "dwarf" },
