{
  "provenance": "T13-F017 band-rule recipient contract cases. Canonical shapes and IDs copied from sources/knowledge/bands/mordheim/adventurers-kaz/special-rules.yaml (band--dwarf/elf/barbarian/noble-special-skills, band--no-fixed-leader, band--hired-swords, dwarf--hard-to-kill) and sources/knowledge/bands/mordheim/black-dwarfs/special-rules.yaml (band--hard-to-kill eligibility). band--contract-* rules are reduced cases for the conjunction, empty-list and ordering conventions. Expectations come from the canonical facts and the accepted F035 register (T13-F017), never from applicableRules output.",
  "cases": [
    {
      "name": "recipient-scoped band table reaches its named profile only",
      "package": {
        "band": { "id": "adventurers-kaz" },
        "profiles": [],
        "equipment_lists": [],
        "special_rules": [
          { "id": "band--dwarf-special-skills", "applies_to": { "band": true, "profile_ids": ["dwarf"] }, "runtime": { "grant": "band", "implemented": "YES" } },
          { "id": "band--elf-special-skills", "applies_to": { "band": true, "profile_ids": ["elf"] }, "runtime": { "grant": "band", "implemented": "YES" } },
          { "id": "band--barbarian-special-skills", "applies_to": { "band": true, "profile_ids": ["barbarian"] }, "runtime": { "grant": "band", "implemented": "YES" } },
          { "id": "band--noble-special-skills", "applies_to": { "band": true, "profile_ids": ["imperial-noble"] }, "runtime": { "grant": "band", "implemented": "YES" } },
          { "id": "band--no-fixed-leader", "applies_to": { "band": true }, "runtime": { "grant": "band", "implemented": "NO" } },
          { "id": "band--hired-swords", "applies_to": { "band": true }, "runtime": { "grant": "band", "implemented": "NO" } }
        ]
      },
      "profile": { "id": "dwarf" },
      "expected_rule_ids": ["band--dwarf-special-skills", "band--no-fixed-leader", "band--hired-swords"]
    },
    {
      "name": "non-recipient receives only the genuine band-wide grants",
      "package": {
        "band": { "id": "adventurers-kaz" },
        "profiles": [],
        "equipment_lists": [],
        "special_rules": [
          { "id": "band--dwarf-special-skills", "applies_to": { "band": true, "profile_ids": ["dwarf"] }, "runtime": { "grant": "band", "implemented": "YES" } },
          { "id": "band--elf-special-skills", "applies_to": { "band": true, "profile_ids": ["elf"] }, "runtime": { "grant": "band", "implemented": "YES" } },
          { "id": "band--barbarian-special-skills", "applies_to": { "band": true, "profile_ids": ["barbarian"] }, "runtime": { "grant": "band", "implemented": "YES" } },
          { "id": "band--noble-special-skills", "applies_to": { "band": true, "profile_ids": ["imperial-noble"] }, "runtime": { "grant": "band", "implemented": "YES" } },
          { "id": "band--no-fixed-leader", "applies_to": { "band": true }, "runtime": { "grant": "band", "implemented": "NO" } },
          { "id": "band--hired-swords", "applies_to": { "band": true }, "runtime": { "grant": "band", "implemented": "NO" } }
        ]
      },
      "profile": { "id": "wizard" },
      "expected_rule_ids": ["band--no-fixed-leader", "band--hired-swords"]
    },
    {
      "name": "eligibility alone restricts a band grant",
      "package": {
        "band": { "id": "black-dwarfs" },
        "profiles": [],
        "equipment_lists": [],
        "special_rules": [
          { "id": "band--hard-to-kill", "applies_to": { "band": true }, "eligibility": ["sorcerer", "bull-centaur", "gaolers", "chaos-dwarfs"], "runtime": { "grant": "band", "implemented": "YES" } },
          { "id": "band--contract-wide", "applies_to": { "band": true }, "runtime": { "grant": "band", "implemented": "NO" } }
        ]
      },
      "profile": { "id": "sorcerer" },
      "expected_rule_ids": ["band--hard-to-kill", "band--contract-wide"]
    },
    {
      "name": "eligibility excludes a profile outside its list",
      "package": {
        "band": { "id": "black-dwarfs" },
        "profiles": [],
        "equipment_lists": [],
        "special_rules": [
          { "id": "band--hard-to-kill", "applies_to": { "band": true }, "eligibility": ["sorcerer", "bull-centaur", "gaolers", "chaos-dwarfs"], "runtime": { "grant": "band", "implemented": "YES" } },
          { "id": "band--contract-wide", "applies_to": { "band": true }, "runtime": { "grant": "band", "implemented": "NO" } }
        ]
      },
      "profile": { "id": "informers" },
      "expected_rule_ids": ["band--contract-wide"]
