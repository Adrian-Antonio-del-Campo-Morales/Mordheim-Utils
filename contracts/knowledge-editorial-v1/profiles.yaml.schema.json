{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mordheim-utils.invalid/contracts/knowledge-editorial-v1/profiles.yaml.schema.json",
  "title": "Mordheim KB warband — profiles.yaml",
  "description": "Every profile a warband can field: heroes, henchmen, animals and summoned creatures, with their construction cost, characteristic line, equipment access and inherent rules. Shared definitions live in defs.schema.json.",
  "type": "object",
  "required": ["schema_version", "band_id", "profiles"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "band_id": {
      "description": "Band the profiles belong to; must match the directory and `band.yaml`.",
      "$ref": "defs.schema.json#/$defs/id"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": [
        "id", "name", "name_i18n", "type", "cost", "experience", "characteristics",
        "equipment_lists", "equipment_restrictions", "fixed_equipment", "skill_access",
        "rule_ids", "source", "source_path"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Profile id, referenced by `band.yaml` roster members and by rule `applies_to` / `eligibility`.",
          "$ref": "defs.schema.json#/$defs/id"
        },
        "name": { "$ref": "defs.schema.json#/$defs/display_text" },
        "name_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "type": {
          "description": "`hero` and `henchman` are the roster kinds; `animal` and `summoned` are creatures attached to the warband.",
          "enum": ["hero", "henchman", "animal", "summoned"]
        },
        "cost": {
          "description": "Recruitment cost in gold crowns at warband creation.",
          "type": "integer",
          "minimum": 0
        },
        "experience": {
          "description": "Starting experience of the profile.",
          "type": "integer",
          "minimum": 0
        },
        "characteristics": { "$ref": "defs.schema.json#/$defs/characteristic_map" },
        "equipment_lists": {
          "description": "Equipment lists of `equipment-access.yaml` this profile may buy from.",
          "type": "array",
          "items": { "$ref": "defs.schema.json#/$defs/id" }
        },
        "equipment_restrictions": {
          "description": "Editorial restrictions of the profile, as prose reviewed against the source.",
          "type": "array",
          "items": { "$ref": "defs.schema.json#/$defs/display_text" }
        },
        "fixed_equipment": {
          "description": "Item ids every model of this profile starts with.",
          "type": "array",
          "items": { "$ref": "defs.schema.json#/$defs/id" }
        },
        "skill_access": {
          "description": "Skill lists the profile may learn from: `combat`, `shooting`, `academic`, `strength`, `speed`, `special` and the `cavalry` list used by mounted warbands.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z-]*$" }
        },
        "rule_ids": {
          "description": "Rules of `special-rules.yaml` granted to the profile.",
          "type": "array",
          "items": { "$ref": "defs.schema.json#/$defs/rule_id" }
        },
        "combat_traits": {
          "description": "Executable traits of the profile. The key registry is `mordheim_construction.contracts.TRAIT_TYPES`; `tests/knowledge/test_editorial_schemas.py` fails when this definition drifts from it.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "starting_skills": {
              "description": "Mechanic ids of skills the profile starts with.",
              "type": "array",
              "items": { "$ref": "defs.schema.json#/$defs/id" }
            },
            "natural_armour_save": { "type": "integer" },
            "injury_profile": { "type": "integer" },
            "ward_save": { "type": "integer" },
            "regeneration_save": { "type": "integer" },
            "extra_natural_attacks": { "type": "integer" },
            "poison_immune": { "type": "boolean" },
            "undead_or_possessed": { "type": "boolean" },
            "frenzy": { "type": "boolean" },
            "cloud_of_flies": { "type": "boolean" },
            "natural_armour_stacks": { "type": "boolean" },
            "charge_attack_bonus": { "type": "boolean" },
            "first_round_charge_attack_bonus": { "type": "boolean" },
            "maddened_with_pain": { "type": "boolean" },
            "natural_armour_unmodified": { "type": "boolean" },
            "poisonous_injury": { "type": "boolean" },
            "survivor": { "type": "boolean" },
            "natural_armour_worst_save": { "type": "integer" },
            "concussion_immune": { "type": "boolean" },
            "wight_blades": { "type": "boolean" },
            "perfect_killer": { "type": "boolean" },
            "counts_as_buckler": { "type": "boolean" },
            "counts_as_shield": { "type": "boolean" },
            "fragile_halflings": { "type": "boolean" },
            "flammable": { "type": "boolean" },
            "ward_save_mundane_only": { "type": "boolean" },
            "natural_armour_negated_by_magic": { "type": "boolean" },
            "magical_attacks": { "type": "boolean" },
            "regeneration_blocked_by_fire": { "type": "boolean" },
            "regeneration_blocked_by_blessed": { "type": "boolean" },
            "caught_fire_threshold": { "type": "integer" },
            "injury_reroll_out": { "type": "boolean" },
            "dagger_master": { "type": "boolean" },
            "spiritual_weapons": { "type": "boolean" },
            "bear_hug": { "type": "boolean" },
            "acid_blood": { "type": "boolean" },
            "spines": { "type": "boolean" },
            "scorpion_tail": { "type": "boolean" },
            "huge_jaws": { "type": "boolean" },
            "pit_fighter": { "type": "boolean" },
            "animal_friendship": { "type": "boolean" },
            "contagious": { "type": "boolean" },
            "guardian_unarmed": { "type": "boolean" },
            "mark_of_onogal_the_crow": { "type": "boolean" }
          }
        },
        "components": {
          "description": "Compound profiles (cart, horse, chariot …) that fight as one model.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component" }
        },
        "group_size": {
          "description": "Size of a henchman group of this profile, when the source sets it.",
          "type": "object",
          "required": ["minimum", "maximum"],
          "additionalProperties": false,
          "properties": {
            "minimum": { "type": "integer", "minimum": 0 },
            "maximum": { "type": ["integer", "null"] }
          }
        },
        "bloodline": {
          "description": "Bloodline the profile belongs to (Trollheim undead warbands).",
          "$ref": "defs.schema.json#/$defs/id"
        },
        "source": { "$ref": "defs.schema.json#/$defs/source_ref" },
        "source_path": {
          "description": "Reader path inside the source: roster section first (`heroes`, `henchmen`, …), then the printed headings.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "defs.schema.json#/$defs/display_text" }
        }
      }
    },
    "component": {
      "description": "One part of a compound profile: it declares only the characteristics it contributes.",
      "type": "object",
      "required": ["id", "name", "characteristics"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "defs.schema.json#/$defs/id" },
        "name": { "$ref": "defs.schema.json#/$defs/display_text" },
        "characteristics": { "$ref": "defs.schema.json#/$defs/characteristic_map" }
      }
    }
  }
}
