{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mordheim-utils.invalid/contracts/knowledge-editorial-v1/catalog-mechanics-close-combat.yaml.schema.json",
  "title": "Mordheim KB catalogue — catalog/mechanics/close-combat.yaml",
  "description": "The engine-facing catalogue: weapon, armour, defence, material, preparation, poison and skill mechanics under their `weapon.*`, `armour.*` … namespaces, each with the engine option the engines understand. Item records and band rules bind to these mechanics instead of duplicating them.",
  "type": "object",
  "required": [
    "schema_version", "ruleset", "scope", "weapons", "armours", "defences", "materials",
    "preparations", "poisons", "skills", "pending_mechanics"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "ruleset": { "$ref": "defs.schema.json#/$defs/id" },
    "scope": { "$ref": "defs.schema.json#/$defs/runtime_scope" },
    "weapons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/weapon" } },
    "armours": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/armour" } },
    "defences": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/defence" } },
    "materials": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/code_mechanic" } },
    "preparations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/code_mechanic" } },
    "poisons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/code_mechanic" } },
    "skills": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/skill" } },
    "pending_mechanics": {
      "description": "Mechanics whose executable contract is not finished; empty today.",
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "$defs": {
    "weapon": {
      "type": "object",
      "required": [
        "id", "name", "name_i18n", "effect", "effect_i18n", "engine_option", "hands",
        "main_hand", "off_hand", "paired", "rules_source_url", "source_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "defs.schema.json#/$defs/id" },
        "name": { "$ref": "defs.schema.json#/$defs/display_text" },
        "name_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "effect": { "$ref": "defs.schema.json#/$defs/display_text" },
        "effect_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "engine_option": { "$ref": "#/$defs/engine_option" },
        "hands": { "type": "integer", "enum": [1, 2] },
        "main_hand": { "type": "boolean" },
        "off_hand": { "type": "boolean" },
        "paired": { "type": "boolean" },
        "rules_source_url": { "$ref": "#/$defs/rules_source_url" },
        "source_refs": { "$ref": "defs.schema.json#/$defs/source_refs" }
      }
    },
    "armour": {
      "type": "object",
      "required": [
        "id", "name", "name_i18n", "effect", "effect_i18n", "engine_option", "base_save",
        "rules_source_url", "source_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "defs.schema.json#/$defs/id" },
        "name": { "$ref": "defs.schema.json#/$defs/display_text" },
        "name_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "effect": { "$ref": "defs.schema.json#/$defs/display_text" },
        "effect_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "engine_option": { "$ref": "#/$defs/engine_option" },
        "engine_code": { "type": "integer" },
        "base_save": {
          "description": "Save the armour grants, or null for armour that only modifies another save (an overlay).",
          "type": ["integer", "null"]
        },
        "overlay": { "type": "boolean" },
        "rules_source_url": { "$ref": "#/$defs/rules_source_url" },
        "source_refs": { "$ref": "defs.schema.json#/$defs/source_refs" }
      }
    },
    "defence": {
      "type": "object",
      "required": ["id", "name", "name_i18n", "effect", "effect_i18n", "engine_option", "source_refs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "defs.schema.json#/$defs/id" },
        "name": { "$ref": "defs.schema.json#/$defs/display_text" },
        "name_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "effect": { "$ref": "defs.schema.json#/$defs/display_text" },
        "effect_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "engine_option": { "$ref": "#/$defs/engine_option" },
        "source_refs": { "$ref": "defs.schema.json#/$defs/source_refs" }
      }
    },
    "code_mechanic": {
      "description": "Material, preparation or poison mechanic: the engines identify it by its numeric code as well as by its option.",
      "type": "object",
      "required": ["id", "name", "name_i18n", "effect", "effect_i18n", "engine_option", "engine_code", "source_refs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "defs.schema.json#/$defs/id" },
        "name": { "$ref": "defs.schema.json#/$defs/display_text" },
        "name_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "effect": { "$ref": "defs.schema.json#/$defs/display_text" },
        "effect_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "engine_option": { "$ref": "#/$defs/engine_option" },
        "engine_code": { "type": "integer" },
        "source_refs": { "$ref": "defs.schema.json#/$defs/source_refs" }
      }
    },
    "skill": {
      "description": "Skill mechanic: the executable projection of a skill (its engine option), classified by the skill family it belongs to.",
      "type": "object",
      "required": ["id", "name", "name_i18n", "effect", "effect_i18n", "engine_option", "kind", "category", "source_refs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "defs.schema.json#/$defs/id" },
        "name": { "$ref": "defs.schema.json#/$defs/display_text" },
        "name_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "effect": { "$ref": "defs.schema.json#/$defs/display_text" },
        "effect_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "engine_option": { "$ref": "#/$defs/engine_option" },
        "kind": {
          "description": "`general` and `warband` mirror the skill tables; `profile` marks a skill only a specific profile has.",
          "enum": ["general", "warband", "profile"]
        },
        "category": {
          "description": "Effect family of the mechanic (not necessarily a learnable skill table), e.g. `armour`, `attacks`, `initiative`.",
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z-]*$"
        },
        "rules_source_url": { "$ref": "#/$defs/rules_source_url" },
        "source_refs": { "$ref": "defs.schema.json#/$defs/source_refs" }
      }
    },
    "engine_option": {
      "description": "Name of the option the engines understand (the exact string the engine tables use).",
      "type": "string",
      "minLength": 1
    },
    "rules_source_url": {
      "description": "Canonical page of the mechanic's rules text.",
      "type": "string",
      "minLength": 1
    }
  }
}
