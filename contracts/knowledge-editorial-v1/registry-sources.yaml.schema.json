{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mordheim-utils.invalid/contracts/knowledge-editorial-v1/registry-sources.yaml.schema.json",
  "title": "Mordheim KB registry — registry/sources.yaml",
  "description": "Registered editorial sources. Source ids are the `manual` value every `source_ref` uses, so a new manual is registered here before records point at it.",
  "type": "object",
  "required": ["schema_version", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "defs.schema.json#/$defs/id" },
          "name": { "$ref": "defs.schema.json#/$defs/display_text" }
        }
      }
    }
  }
}
