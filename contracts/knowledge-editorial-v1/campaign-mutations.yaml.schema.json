{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mordheim-utils.invalid/contracts/knowledge-editorial-v1/campaign-mutations.yaml.schema.json",
  "title": "Mordheim KB catalogue — catalog/campaign/mutations.yaml",
  "description": "Chaos mutation purchase rules and source prose, plus the explicit MiM D66 results used by the Inquisitor in a duel. Campaign acquisition remains outside the duel engine.",
  "type": "object",
  "required": ["schema_version", "ruleset", "catalog", "status", "rules", "mutations", "effect_ids"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "ruleset": { "$ref": "defs.schema.json#/$defs/id" },
    "catalog": { "$ref": "defs.schema.json#/$defs/id" },
    "status": { "$ref": "defs.schema.json#/$defs/catalog_status" },
    "rules": { "$ref": "#/$defs/purchase_rules" },
    "mutations": {
      "description": "The mutation list.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mutation" }
    },
    "random_mutation_chart": {
      "description": "Literal MiM Random Mutation Chart results. Excluded facets retain their source without inventing a duel producer.",
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "roll",
          "name",
          "source_refs"
        ],
        "properties": {
          "roll": {
            "enum": [
              11,
              12,
              13,
              14,
              15,
              16,
              21,
              22,
              23,
              24,
              25,
              26,
              31,
              32,
              33,
              34,
              35,
              36,
              41,
              42,
              43,
              44,
              45,
              46,
              51,
              52,
              53,
              54,
              55,
              56,
              61,
              62,
              63,
              64,
              65,
              66
            ]
          },
          "name": {
            "$ref": "defs.schema.json#/$defs/display_text"
          },
          "name_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
          "effect_ids": {
            "$ref": "defs.schema.json#/$defs/id_list"
          },
          "limb_effect_ids": {
            "$ref": "defs.schema.json#/$defs/id_list"
          },
          "effect_parameters": {
            "$ref": "catalog-mechanics-execution.yaml.schema.json#/$defs/mechanic/properties/parameters"
          },
          "extra_attack_parameters": {
            "type": "array",
            "items": {
              "$ref": "catalog-mechanics-execution.yaml.schema.json#/$defs/mechanic/properties/parameters"
            }
          },
          "stat_ops": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                {
                  "enum": [
                    "movement",
                    "weapon_skill",
                    "ballistic_skill",
                    "strength",
                    "toughness",
                    "wounds",
                    "initiative",
                    "attacks",
                    "leadership",
                    "natural_armour_save",
                    "natural_armour_worst_save"
                  ]
                },
                {
                  "enum": [
                    "add",
                    "set",
                    "halve-ceil"
                  ]
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          "excluded_facet": {
            "$ref": "defs.schema.json#/$defs/display_text"
          },
          "source_refs": {
            "$ref": "defs.schema.json#/$defs/source_refs"
          }
        }
      }
    },
    "grant_rules": {
      "description": "Printed band rules that grant a mutation. Each one names the band, its rule, who may receive a mutation and the mutation ids the rule lists; the ids the rule names but the catalogue does not publish are listed by name instead of invented.",
      "type": "array",
      "items": { "$ref": "#/$defs/grant_rule" }
    },
    "effect_ids": {
      "description": "Effects of this catalogue a warband's own special rules may modify.",
      "$ref": "defs.schema.json#/$defs/id_list"
    }
  },
  "$defs": {
    "purchase_rules": {
      "description": "When and at what price a mutation may be bought.",
      "type": "object",
      "required": ["id", "purchase", "source_refs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "defs.schema.json#/$defs/id" },
        "purchase": {
          "type": "object",
          "required": ["timing", "pricing", "note"],
          "additionalProperties": false,
          "properties": {
            "timing": {
              "description": "When a mutation may be bought. Currently only at recruitment, as the source states.",
              "const": "at_recruitment_only"
            },
            "pricing": {
              "description": "How the listed price of a mutation is applied.",
              "type": "object",
              "required": ["first_mutation", "second_and_subsequent"],
              "additionalProperties": false,
              "properties": {
                "first_mutation": {
                  "description": "Price of the first mutation a warrior takes.",
                  "const": "listed_price"
                },
                "second_and_subsequent": {
                  "description": "Price of every later mutation, as the source states it.",
                  "const": "double_listed_price"
                }
              }
            },
            "note": { "$ref": "defs.schema.json#/$defs/display_text" },
            "note_i18n": { "$ref": "defs.schema.json#/$defs/i18n" }
          }
        },
        "source_refs": { "$ref": "defs.schema.json#/$defs/source_refs" }
      }
    },
    "mutation": {
      "description": "One mutation: the listed price and the source text of its effect.",
      "type": "object",
      "required": ["id", "name", "name_i18n", "cost_gc", "effect", "effect_i18n", "source_refs"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable mutation id of the `campaign.mutation.*` family.",
          "$ref": "defs.schema.json#/$defs/id"
        },
        "name": { "$ref": "defs.schema.json#/$defs/display_text" },
        "name_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "cost_gc": {
          "description": "Listed price in gold crowns, before the purchase rule's doubling.",
          "type": "integer",
          "minimum": 0
        },
        "effect": { "$ref": "defs.schema.json#/$defs/display_text" },
        "effect_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "source_refs": { "$ref": "defs.schema.json#/$defs/source_refs" }
      }
    },
    "grant_rule": {
      "description": "One printed grant of mutations: the recipients and the catalogue ids the rule lists.",
      "type": "object",
      "required": ["id", "band_id", "rule_id", "recipients", "profile_ids", "mutation_ids", "name", "effect", "source_refs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "defs.schema.json#/$defs/id" },
        "band_id": {
          "description": "Band the grant belongs to.",
          "$ref": "defs.schema.json#/$defs/id"
        },
        "rule_id": {
          "description": "Printed band rule the grant transcribes.",
          "$ref": "defs.schema.json#/$defs/id"
        },
        "recipients": {
          "description": "Who the printed rule grants a mutation to. Currently only Heroes, as the source states.",
          "const": "hero"
        },
        "profile_ids": {
          "description": "Recipient profiles; empty when the printed rule names none.",
          "$ref": "defs.schema.json#/$defs/id_list"
        },
        "mutation_ids": {
          "description": "Catalogue mutation ids the printed rule lists.",
          "$ref": "defs.schema.json#/$defs/id_list"
        },
        "unrouted_mutation_names": {
          "description": "Mutation names the printed rule lists that the catalogue does not publish (no listed price in the available sources).",
          "type": "array",
          "items": { "$ref": "defs.schema.json#/$defs/display_text" }
        },
        "limit_per_warrior": {
          "description": "Printed per-warrior cap, when the source states one.",
          "type": "integer",
          "minimum": 0
        },
        "name": { "$ref": "defs.schema.json#/$defs/display_text" },
        "name_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "effect": { "$ref": "defs.schema.json#/$defs/display_text" },
        "effect_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "source_refs": { "$ref": "defs.schema.json#/$defs/source_refs" }
      }
    }
  }
}
