{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mordheim-utils.invalid/contracts/knowledge-editorial-v1/registry-aliases.yaml.schema.json",
  "title": "Mordheim KB registry — registry/aliases.yaml",
  "description": "Band aliases used for name normalization. Aliases never replace ids: a band is renamed by adding an alias here, never by renaming its id.",
  "type": "object",
  "required": ["schema_version", "band_aliases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "band_aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["band_id", "aliases"],
        "additionalProperties": false,
        "properties": {
          "band_id": {
            "description": "Band the aliases resolve to.",
            "$ref": "defs.schema.json#/$defs/id"
          },
          "aliases": {
            "description": "Names the band is also published or referred to as.",
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "defs.schema.json#/$defs/display_text" }
          }
        }
      }
    }
  }
}
