{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mordheim-utils.invalid/contracts/knowledge-editorial-v1/catalog-mechanics-simulation-mappings.yaml.schema.json",
  "title": "Mordheim KB catalogue — catalog/mechanics/simulation-mappings.yaml",
  "description": "The item→engine bridge: every item id resolves to `implemented` (with the engine option the engines use) or to `out_of_scope`. Items not listed here are derived from their own record by `load_simulation_mappings`.",
  "type": "object",
  "required": ["schema_version", "ruleset", "item_mappings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "ruleset": { "$ref": "defs.schema.json#/$defs/id" },
    "item_mappings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item_mapping" }
    }
  },
  "$defs": {
    "item_mapping": {
      "type": "object",
      "required": ["item_id", "status"],
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "description": "Canonical item id of `catalog/items/`.",
          "$ref": "defs.schema.json#/$defs/id"
        },
        "status": { "enum": ["implemented", "out_of_scope"] },
        "engine_option": {
          "description": "Engine option the item compiles to.",
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "description": "An implemented mapping must name the engine option it uses.",
          "if": {
            "properties": { "status": { "const": "implemented" } },
            "required": ["status"]
          },
          "then": { "required": ["engine_option"] }
        }
      ]
    }
  }
}
