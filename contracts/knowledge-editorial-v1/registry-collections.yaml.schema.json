{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mordheim-utils.invalid/contracts/knowledge-editorial-v1/registry-collections.yaml.schema.json",
  "title": "Mordheim KB registry — registry/collections.yaml",
  "description": "The band collections and the rulesets each one allows. `load_bands` refuses a band whose `ruleset` its collection does not list, so a new collection starts here.",
  "type": "object",
  "required": ["schema_version", "collections"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "collections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "rulesets"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Collection id; it is also the directory name under `bands/`.",
            "$ref": "defs.schema.json#/$defs/id"
          },
          "name": { "$ref": "defs.schema.json#/$defs/display_text" },
          "status": {
            "description": "Lifecycle of the collection. Currently `active`.",
            "type": "string",
            "minLength": 1
          },
          "rulesets": {
            "description": "Rulesets the collection may use.",
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "defs.schema.json#/$defs/id" }
          }
        }
      }
    }
  }
}
