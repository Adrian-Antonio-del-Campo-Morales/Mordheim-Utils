{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mordheim-utils.invalid/contracts/knowledge-editorial-v1/campaign-post-battle-sequence.yaml.schema.json",
  "title": "Mordheim KB catalogue — catalog/campaign/post-battle-sequence.yaml",
  "description": "The post-battle sequence: the steps a campaign resolves after a battle, in the normative order the source prints them. The order is the rule — a step is identified by its `campaign.step.*` id, not by its position, and each step names the sibling document that defines the data it resolves. The KB declares the sequence; the accumulated state of a concrete campaign stays outside it.",
  "type": "object",
  "required": ["schema_version", "ruleset", "catalog", "status", "sequence"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "ruleset": { "$ref": "defs.schema.json#/$defs/id" },
    "catalog": { "$ref": "defs.schema.json#/$defs/id" },
    "status": { "$ref": "defs.schema.json#/$defs/catalog_status" },
    "sequence": { "$ref": "#/$defs/sequence" }
  },
  "$defs": {
    "sequence": {
      "description": "The sequence as a whole.",
      "type": "object",
      "required": ["id", "name", "name_i18n", "steps", "source_refs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "defs.schema.json#/$defs/id" },
        "name": { "$ref": "defs.schema.json#/$defs/display_text" },
        "name_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "steps": {
          "description": "The steps, sorted by `order`.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        },
        "source_refs": { "$ref": "defs.schema.json#/$defs/source_refs" }
      }
    },
    "step": {
      "description": "One step of the sequence.",
      "type": "object",
      "required": ["order", "id", "name", "name_i18n", "resolves", "repeatability", "source_refs"],
      "additionalProperties": false,
      "properties": {
        "order": {
          "description": "Position of the step. Contiguous and ascending from 1; the order is part of the rule.",
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "description": "Stable step id of the `campaign.step.*` family.",
          "$ref": "defs.schema.json#/$defs/id"
        },
        "name": { "$ref": "defs.schema.json#/$defs/display_text" },
        "name_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "resolves": {
          "description": "Document of this same directory that defines the data the step resolves. It is a file of `catalog/campaign/`, so a step can never point at a document that does not exist.",
          "enum": [
            "exploration-and-income.yaml",
            "experience-and-advances.yaml",
            "hired-swords-and-dramatis.yaml",
            "magic.yaml",
            "mutations.yaml",
            "post-battle-sequence.yaml",
            "recruitment-and-veterans.yaml",
            "scenario-rewards.yaml",
            "scenarios.yaml",
            "serious-injuries.yaml",
            "trading-and-rarity.yaml",
            "trading-post.yaml",
            "warband-rating.yaml"
          ]
        },
        "repeatability": {
          "description": "`once` for a step resolved a single time per battle, `repeatable` for one the player may go back to.",
          "enum": ["once", "repeatable"]
        },
        "source_refs": { "$ref": "defs.schema.json#/$defs/source_refs" }
      }
    }
  }
}
