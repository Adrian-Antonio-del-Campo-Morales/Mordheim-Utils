{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mordheim-utils.invalid/contracts/knowledge-editorial-v1/catalog-rules-conditions.yaml.schema.json",
  "title": "Mordheim KB catalogue — catalog/rules/conditions.yaml",
  "description": "Conditions shared by rules (fear, frenzy, stupidity …). A condition is editorial text with a stable id that rules reference instead of restating the effect.",
  "type": "object",
  "required": ["schema_version", "ruleset", "conditions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "ruleset": { "$ref": "defs.schema.json#/$defs/id" },
    "note": {
      "description": "Editorial note about the catalogue as a whole.",
      "type": "string",
      "minLength": 1
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/condition" }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "required": ["id", "name", "name_i18n", "effect", "effect_i18n", "source_refs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "defs.schema.json#/$defs/id" },
        "name": { "$ref": "defs.schema.json#/$defs/display_text" },
        "name_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "effect": { "$ref": "defs.schema.json#/$defs/display_text" },
        "effect_i18n": { "$ref": "defs.schema.json#/$defs/i18n" },
        "source_refs": { "$ref": "defs.schema.json#/$defs/source_refs" }
      }
    }
  }
}
