{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mordheim-utils.invalid/contracts/knowledge-editorial-v1/registry-runtime-schema.yaml.schema.json",
  "title": "Mordheim KB registry — registry/runtime-schema.yaml",
  "description": "The classification contract itself: the fields every classified rule declares, the values they may take, the kinds a selectable rule can be, the binding kinds, and the invariants the knowledge base must satisfy. The editorial schemas mirror these values; `tests/python/knowledge/test_editorial_schemas.py` fails when either side drifts.",
  "type": "object",
  "required": ["schema_version", "entity", "description", "runtime", "selectable_rule", "invariants"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "entity": {
      "description": "Entity the contract classifies. Currently `special-rule`.",
      "type": "string",
      "minLength": 1
    },
    "description": {
      "description": "What the contract is for.",
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "description": "The `runtime` block every classified rule carries.",
      "type": "object",
      "required": ["required_fields", "scope_values", "implemented_values", "grant_values"],
      "additionalProperties": false,
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "scope_values": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["YES", "NO", "LATER"] }
        },
        "implemented_values": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["YES", "NO"] }
        },
        "grant_values": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["profile", "band", "selectable", "none"] }
        }
      }
    },
    "selectable_rule": {
      "description": "What a `grant: selectable` rule adds.",
      "type": "object",
      "required": ["required_field", "kind_values", "binding_kinds", "effect_required_fields"],
      "additionalProperties": false,
      "properties": {
        "required_field": {
          "description": "Field a selectable rule must declare. Currently `kind`.",
          "type": "string",
          "minLength": 1
        },
        "kind_values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "warband_skill", "mutation", "blessing", "virtue", "mark", "modification",
              "profile_ability", "warband_variant"
            ]
          }
        },
        "binding_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["mechanic", "trait", "profile", "compiler"] }
        },
        "effect_required_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "invariants": {
      "description": "The invariants every classified rule must satisfy, one sentence each.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
