{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": {
      "@domain/*": ["domain/*"],
      "@app/*": ["application/*"],
      "@adapters/*": ["adapters/*"]
    }
  },
  "include": [
    "domain/**/*.ts",
    "application/**/*.ts",
    "adapters/**/*.ts",
    "vitest.config.ts",
    "../tests/typescript/**/*.ts"
  ]
}
