{
  "name": "warband-manager-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Web (React + Vite + TypeScript) Mordheim Campaign Manager.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && npm run check:presentation",
    "check:presentation": "node --test tools/presentation-audit.test.mjs tools/presentation-types.test.mjs tools/presentation-flow-audit.test.mjs && node tools/presentation-audit.mjs --strict --deep --check",
    "audit:gui:deep": "node tools/presentation-audit.mjs --strict --deep --check",
    "audit:gui": "node tools/presentation-audit.mjs --strict --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
