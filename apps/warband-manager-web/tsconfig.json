{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@domain": ["../../packages/typescript/domain/campaign/index.ts"],
      "@domain/*": ["../../packages/typescript/domain/*"],
      "@app": ["../../packages/typescript/application/campaign/index.ts"],
      "@app/*": ["../../packages/typescript/application/*"],
      "@adapters/*": ["../../packages/typescript/adapters/*"]
    },
    "skipLibCheck": true,
    "noEmit": true,
    "useDefineForClassFields": true
  },
  "include": ["src", "vite.config.ts"]
}
